<Project Sdk="Microsoft.NET.Sdk">
  <!-- Built on the runner against the installed SigmaStudio+, never shipped with
       it: SsPlusHost is its Host folder (the console app's), and the build copies
       none of its assemblies. SigmaStudio+ is 32-bit .NET Framework 4.7.2. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ssplus-script</AssemblyName>
    <RootNamespace>SsPlusScript</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <SsPlusHost Condition="'$(SsPlusHost)' == ''">$(SSPLUS_HOME)\Host</SsPlusHost>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="TypeDefinitions"><HintPath>$(SsPlusHost)\TypeDefinitions.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ComponentManager"><HintPath>$(SsPlusHost)\ComponentManager.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SdkFacade"><HintPath>$(SsPlusHost)\SdkFacade.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(SsPlusHost)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Serilog"><HintPath>$(SsPlusHost)\Serilog.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Serilog.Sinks.File"><HintPath>$(SsPlusHost)\Serilog.Sinks.File.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
